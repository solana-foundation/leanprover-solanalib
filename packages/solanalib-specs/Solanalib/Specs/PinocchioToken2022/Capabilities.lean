    | .state_mint_Mint_from_account_view => []

/-- The selected members and generic instantiations required by a client. -/
abbrev Selection := Solanalib.Contracts.Model.Capabilities.Selection catalog

/-- One fixed assignment of the supplied outcome relations. -/
abbrev Operations := Solanalib.Contracts.Model.Capabilities.Operations catalog

/-- Explicit propositional assumptions on just the requested operations. -/
abbrev Spec (needs : Selection) (operations : Operations) : Prop :=
  Solanalib.Contracts.Model.Capabilities.Spec catalog needs operations

/-- The existing mathematical references, with no Rust correctness claim. -/
def reference : Operations := fun key => match key with
  | .instructions_close_account_CloseAccount_invoke_signed =>
    instructions.close_account.CloseAccount.invoke_signed_reference
  | .instructions_transfer_checked_TransferChecked_invoke =>
    instructions.transfer_checked.TransferChecked.invoke_reference
  | .instructions_transfer_checked_TransferChecked_invoke_signed =>
    instructions.transfer_checked.TransferChecked.invoke_signed_reference
  | .state_account_Account_amount =>
    fun _ => returnsOf state.account.Account.amount_reference
  | .state_account_Account_from_account_view =>
    fun _ => returnsOf state.account.Account.from_account_view_reference
  | .state_account_Account_mint =>
    fun _ => returnsOf state.account.Account.mint_reference
  | .state_account_Account_owner =>
    fun _ => returnsOf state.account.Account.owner_reference
  | .state_account_Account_state =>
    state.account.Account.state_reference
  | .state_mint_Mint_decimals =>
    fun _ => returnsOf state.mint.Mint.decimals_reference
  | .state_mint_Mint_from_account_view =>
    fun _ => returnsOf state.mint.Mint.from_account_view_reference

/-- Existing closed reference theorems establish the entire mathematical
bundle at every generic index. They do not discharge source-call assumptions. -/
theorem reference_spec :
    Spec (Solanalib.Contracts.Model.Capabilities.Selection.all catalog) reference := by
  constructor
  intro key index _
  cases key with
  | instructions_close_account_CloseAccount_invoke_signed =>
    exact instructions.close_account.CloseAccount.invoke_signed_reference_holds index
  | instructions_transfer_checked_TransferChecked_invoke =>
    exact instructions.transfer_checked.TransferChecked.invoke_reference_holds index
  | instructions_transfer_checked_TransferChecked_invoke_signed =>
    exact instructions.transfer_checked.TransferChecked.invoke_signed_reference_holds index
  | state_account_Account_amount =>
    exact (Solanalib.Contracts.Model.realized_iff_holds _ _).mp
      state.account.Account.amount_reference_realizes
  | state_account_Account_from_account_view =>
    exact (Solanalib.Contracts.Model.realized_iff_holds _ _).mp
      state.account.Account.from_account_view_reference_realizes
  | state_account_Account_mint =>
    exact (Solanalib.Contracts.Model.realized_iff_holds _ _).mp
      state.account.Account.mint_reference_realizes
  | state_account_Account_owner =>
    exact (Solanalib.Contracts.Model.realized_iff_holds _ _).mp
      state.account.Account.owner_reference_realizes
  | state_account_Account_state =>
    exact state.account.Account.state_reference_holds index
  | state_mint_Mint_decimals =>
    exact (Solanalib.Contracts.Model.realized_iff_holds _ _).mp
      state.mint.Mint.decimals_reference_realizes
  | state_mint_Mint_from_account_view =>
    exact (Solanalib.Contracts.Model.realized_iff_holds _ _).mp
      state.mint.Mint.from_account_view_reference_realizes

