namespace VerificationLevel

/-- A decimal digit as a character. -/
def decimalDigit (digit : Nat) : Char := Char.ofNat (48 + digit)

/-- `{:?}` of a `u8`: its decimal digits without padding. Written out here so
that proofs can evaluate it; it agrees with `toString value.toNat`. -/
def decimalU8 (value : UInt8) : String :=
  let number := value.toNat
  String.ofList <|
    if number < 10 then [decimalDigit number]
    else if number < 100 then [decimalDigit (number / 10), decimalDigit (number % 10)]
    else [decimalDigit (number / 100), decimalDigit (number / 10 % 10),
      decimalDigit (number % 10)]

/-- `format!("Unexpected variant tag: {:?}", variant_tag)`. -/
def unexpectedVariantTagMessage (tag : UInt8) : String :=
  "Unexpected variant tag: " ++ decimalU8 tag

/-- The `io::Error::new(ErrorKind::InvalidData, …)` generated by the derive. -/
def unexpectedVariantTag (tag : UInt8) : IoError :=
  ⟨.invalidData, unexpectedVariantTagMessage tag⟩

/-- The derived `EnumExt::deserialize_variant`: tag 0 reads
`Partial { num_signatures: u8 }`, tag 1 is `Full`, any other tag is rejected
without reading further. -/
def deserializeVariant (tag : UInt8) : Decoder Pyth.VerificationLevel :=
  if tag = 0 then (decodeU8 Solanalib.Specs.Borsh.invalid_data_profile).map .partialVerification
  else if tag = 1 then Decoder.pure .full
  else fun input => (.error (unexpectedVariantTag tag), input)

/-- The derived `deserialize_reader`: one `u8` tag, then `deserialize_variant`. -/
def decoder : Decoder Pyth.VerificationLevel :=
  (decodeU8 Solanalib.Specs.Borsh.invalid_data_profile).bind deserializeVariant

def deserialize_reader_contract :
    Solanalib.Contracts.Model Unit _root_.Solanalib.Runtime.Bytes
      (Except IoError Pyth.VerificationLevel × _root_.Solanalib.Runtime.Bytes) :=
  decoderContract decoder

def deserialize_reader_model :
    Unit → _root_.Solanalib.Runtime.Bytes →
      (Except IoError Pyth.VerificationLevel × _root_.Solanalib.Runtime.Bytes) × Unit :=
  decoderModel decoder

theorem deserialize_reader_reference :
    deserialize_reader_contract.RealizedBy deserialize_reader_model :=
  decoderContract_realized _

theorem deserialize_reader_satisfiable : deserialize_reader_contract.Satisfiable :=
  decoderContract_satisfiable _

end VerificationLevel

