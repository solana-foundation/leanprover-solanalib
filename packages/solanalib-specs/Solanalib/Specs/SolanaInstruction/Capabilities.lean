/-- Explicit propositional assumptions on just the requested operations. -/
abbrev Spec (needs : Selection) (operations : Operations) : Prop :=
  Solanalib.Contracts.Model.Capabilities.Spec catalog needs operations

/-- The existing mathematical references, with no Rust correctness claim. -/
def reference : Operations := fun key => match key with
  | .AccountMeta_clone => AccountMeta.clone_run
  | .AccountMeta_new => fun _ => returnsOf AccountMeta.new_model
  | .AccountMeta_new_readonly =>
    fun _ => returnsOf AccountMeta.new_readonly_model
  | .Instruction_new_with_bincode =>
    Instruction.new_with_bincode_run
  | .Instruction_new_with_wincode =>
    Instruction.new_with_wincode_run

/-- Existing closed reference theorems establish the entire mathematical
bundle at every generic index. They do not discharge source-call assumptions. -/
theorem reference_spec :
    Spec (Solanalib.Contracts.Model.Capabilities.Selection.all catalog) reference := by
  constructor
  intro key index _
  cases key with
  | AccountMeta_clone => exact AccountMeta.clone_reference index
  | AccountMeta_new =>
    exact (Solanalib.Contracts.Model.realized_iff_holds _ _).mp AccountMeta.new_reference
  | AccountMeta_new_readonly =>
    exact (Solanalib.Contracts.Model.realized_iff_holds _ _).mp AccountMeta.new_readonly_reference
  | Instruction_new_with_bincode =>
    exact Instruction.new_with_bincode_reference index
  | Instruction_new_with_wincode =>
    exact Instruction.new_with_wincode_reference index

end Solanalib.Specs.SolanaInstruction.Capabilities
