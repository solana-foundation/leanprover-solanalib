            equality, key Default is the all-zero key, and these key/Boolean payloads have \
            trivial drop. This profile does not admit arbitrary same-layout nominal types \
            or callback implementations."],
        evidence := ["https://static.crates.io/crates/solana-program-option/solana-program-option-2.1.0.crate", "https://static.crates.io/crates/solana-program-option/solana-program-option-2.2.0.crate", "https://static.crates.io/crates/solana-program-option/solana-program-option-2.2.1.crate"],
        argument :=
          "None moves the evaluated fallback; Some drops that fallback before returning \
            the original payload. Preserve unwind/terminal outcomes and the selected \
            moved-return cleanup policy. The 2.1.0, 2.2.0 and 2.2.1 files are identical. \
            Compatibility within 2.x assumes the same discriminants, callbacks and reached \
            cleanup; concrete key/bool variants retain their gates."
      }
    ]
  applicabilityConsumers := fun key => match key with
    | .COption_as_ref => []
    | .COption_eq => []
    | .COption_is_none => []
    | .COption_is_some => []
    | .COption_map => []
    | .COption_unwrap => []
    | .COption_unwrap_or => []

/-- The selected members and generic instantiations required by a client. -/
abbrev Selection := Solanalib.Contracts.Model.Capabilities.Selection catalog

/-- One fixed assignment of the supplied outcome relations. -/
abbrev Operations := Solanalib.Contracts.Model.Capabilities.Operations catalog

/-- Explicit propositional assumptions on just the requested operations. -/
abbrev Spec (needs : Selection) (operations : Operations) : Prop :=
  Solanalib.Contracts.Model.Capabilities.Spec catalog needs operations

/-- The existing mathematical references, with no Rust correctness claim. -/
def reference : Operations := fun key => match key with
  | .COption_as_ref => COption.as_ref_run
  | .COption_eq => COption.eq_run
  | .COption_is_none => COption.is_none_run
  | .COption_is_some => COption.is_some_run
  | .COption_map => COption.map_run
  | .COption_unwrap => COption.unwrap_run
  | .COption_unwrap_or => COption.unwrap_or_run

/-- Existing closed reference theorems establish the entire mathematical
bundle at every generic index. They do not discharge source-call assumptions. -/
theorem reference_spec :
    Spec (Solanalib.Contracts.Model.Capabilities.Selection.all catalog) reference := by
  constructor
  intro key index _
  cases key with
  | COption_as_ref => exact COption.as_ref_reference index
  | COption_eq => exact COption.eq_reference index
  | COption_is_none => exact COption.is_none_reference index
  | COption_is_some => exact COption.is_some_reference index
  | COption_map => exact COption.map_reference index
  | COption_unwrap => exact COption.unwrap_reference index
  | COption_unwrap_or => exact COption.unwrap_or_reference index

end Solanalib.Specs.SolanaProgramOption.Capabilities
