  | .Pubkey_as_ref => fun _ => returnsOf Pubkey.as_ref_model
  | .Pubkey_clone => fun _ => returnsOf Pubkey.clone_model
  | .Pubkey_cmp => fun _ => returnsOf Pubkey.cmp_model
  | .Pubkey_create_program_address_solana =>
    Pubkey.create_program_address_solana_run
  | .Pubkey_create_with_seed => Pubkey.create_with_seed_run
  | .Pubkey_default => fun _ => returnsOf Pubkey.default_model
  | .Pubkey_deserialize_reader => Pubkey.deserialize_reader_run
  | .Pubkey_eq => fun _ => returnsOf Pubkey.eq_model
  | .Pubkey_find_program_address_solana =>
    Pubkey.find_program_address_solana_run
  | .Pubkey_from => fun _ => returnsOf Pubkey.from_model
  | .Pubkey_new_from_array =>
    fun _ => returnsOf Pubkey.new_from_array_model
  | .Pubkey_serialize => Pubkey.serialize_run
  | .Pubkey_to_bytes => fun _ => returnsOf Pubkey.to_bytes_model

/-- Existing closed reference theorems establish the entire mathematical
bundle at every generic index. They do not discharge source-call assumptions. -/
theorem reference_spec :
    Spec (Solanalib.Contracts.Model.Capabilities.Selection.all catalog) reference := by
  constructor
  intro key index _
  cases key with
  | Pubkey_as_ref =>
    exact (Solanalib.Contracts.Model.realized_iff_holds _ _).mp Pubkey.as_ref_reference
  | Pubkey_clone =>
    exact (Solanalib.Contracts.Model.realized_iff_holds _ _).mp Pubkey.clone_reference
  | Pubkey_cmp =>
    exact (Solanalib.Contracts.Model.realized_iff_holds _ _).mp Pubkey.cmp_reference
  | Pubkey_create_program_address_solana =>
    exact Pubkey.create_program_address_solana_reference index
  | Pubkey_create_with_seed =>
    exact Pubkey.create_with_seed_reference index
  | Pubkey_default =>
    exact (Solanalib.Contracts.Model.realized_iff_holds _ _).mp Pubkey.default_reference
  | Pubkey_deserialize_reader =>
    exact Pubkey.deserialize_reader_reference index
  | Pubkey_eq =>
    exact (Solanalib.Contracts.Model.realized_iff_holds _ _).mp Pubkey.eq_reference
  | Pubkey_find_program_address_solana =>
    exact Pubkey.find_program_address_solana_reference index
  | Pubkey_from =>
    exact (Solanalib.Contracts.Model.realized_iff_holds _ _).mp Pubkey.from_reference
  | Pubkey_new_from_array =>
    exact (Solanalib.Contracts.Model.realized_iff_holds _ _).mp Pubkey.new_from_array_reference
  | Pubkey_serialize => exact Pubkey.serialize_reference index
  | Pubkey_to_bytes =>
    exact (Solanalib.Contracts.Model.realized_iff_holds _ _).mp Pubkey.to_bytes_reference

end Solanalib.Specs.SolanaPubkey.Capabilities
