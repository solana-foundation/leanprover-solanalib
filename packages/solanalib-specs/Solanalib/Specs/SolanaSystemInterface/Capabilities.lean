  | .instruction_transfer_operational =>
    instruction.transfer_operational_run

/-- Existing closed reference theorems establish the entire mathematical
bundle at every generic index. They do not discharge source-call assumptions. -/
theorem reference_spec :
    Spec (Solanalib.Contracts.Model.Capabilities.Selection.all catalog) reference := by
  constructor
  intro key index _
  cases key with
  | instruction_create_account =>
    exact (Solanalib.Contracts.Model.realized_iff_holds _ _).mp instruction.create_account_reference
  | instruction_create_account_allow_prefund =>
    exact instruction.create_account_allow_prefund_reference index
  | instruction_create_account_operational =>
    exact instruction.create_account_operational_reference index
  | instruction_create_account_with_seed =>
    exact instruction.create_account_with_seed_reference index
  | instruction_transfer =>
    exact (Solanalib.Contracts.Model.realized_iff_holds _ _).mp instruction.transfer_reference
  | instruction_transfer_operational =>
    exact instruction.transfer_operational_reference index

end Solanalib.Specs.SolanaSystemInterface.Capabilities
