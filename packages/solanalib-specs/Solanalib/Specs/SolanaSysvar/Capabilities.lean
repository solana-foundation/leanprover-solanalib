  | .rent_Rent_string_error_get => rent.Rent.string_error.get_run

/-- Existing closed reference theorems establish the entire mathematical
bundle at every generic index. They do not discharge source-call assumptions. -/
theorem reference_spec :
    Spec (Solanalib.Contracts.Model.Capabilities.Selection.all catalog) reference := by
  constructor
  intro key index _
  cases key with
  | clock_Clock_get => exact clock.Clock.get_reference index
  | clock_Clock_string_error_get =>
    exact clock.Clock.string_error.get_reference index
  | epoch_schedule_EpochSchedule_get =>
    exact epoch_schedule.EpochSchedule.get_reference index
  | rent_Rent_get => exact rent.Rent.get_reference index
  | rent_Rent_string_error_get =>
    exact rent.Rent.string_error.get_reference index

end Solanalib.Specs.SolanaSysvar.Capabilities
